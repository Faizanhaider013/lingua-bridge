# Public frontend settings; NEVER put credentials in VITE_* variables.
# Recommended single-service deployment and local Vite proxy:
VITE_API_BASE_URL=/api
# For a separate frontend host, set this BEFORE building and redeploy on changes:
# VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com/api

# Local development only; read by Vite, not included in the production bundle.
# VITE_DEV_API_PROXY=http://localhost:8787
