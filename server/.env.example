# Local defaults; copy to server/.env only if you need overrides.
# Set production values in your hosting dashboard, never in committed files.
TRANSLATION_PROVIDER=mymemory
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=false

# Production: NODE_ENV=production, SERVE_FRONTEND=true for the combined service.
# CORS_ORIGIN: comma-separated HTTPS origins. A trailing slash, path or mixed
# case is normalised to the canonical origin; wildcards (*), credentials and
# plain HTTP are rejected. Use the site's exact origin (scheme + host).
# CORS_ORIGIN=https://YOUR-SERVICE.onrender.com
# Let Render supply PORT. Never use * for CORS.

# Per-chunk timeout, default and ceiling 10000ms. Overall translation: 30000ms.
TRANSLATE_TIMEOUT_MS=10000
# Overall UTF-16 message length, default 2000; MyMemory chunks at 500 UTF-8 bytes.
# Raising this does not bypass the 16KiB body or 25-chunk limits.
MAX_TEXT_LENGTH=2000
# Global limits per server process (all callers share them).
MAX_CONCURRENT_TRANSLATIONS=4
REQUESTS_PER_MINUTE=30

# OPTIONAL, backend only. Neither is required for default MyMemory use.
# MYMEMORY_EMAIL=you@example.com
# MYMEMORY_API_KEY=

# Existing paid provider, opt-in only. Do not set for default deployment.
# TRANSLATION_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=
